# MongoDB Connection URL
NEXT_MONGO_URL="mongodb+srv://<username>:<password>@cluster0.f3qxhgj.mongodb.net/?appName=Cluster0"

# Application Base URL
BASE_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Email Configuration (Nodemailer)
NEXT_PUBLIC_EMAIL="your_email@example.com"
NEXT_PUBLIC_PASS="your_email_app_password"

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your_cloudinary_upload_preset"
NEXT_PUBLIC_CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"

# Socket Server URL
NEXT_PUBLIC_SOCEKT_SERVER="http://localhost:3000"

# Bank Payment Details (Used in subscriptions)
NEXT_PUBLIC_BANK_NAME="Your Bank Name"
NEXT_PUBLIC_IBAN="DE00000000000000000000"
NEXT_PUBLIC_SWIFT_CODE="YOURSWIFTXXX"

# JWT Token Secrets
ACCESS_TOKEN_SECRET="generate_a_long_random_string_here"
REFRESH_TOKEN_SECRET="generate_another_long_random_string_here"

# Map and Environment Configuration
NEXT_PUBLIC_ENV="development"
NEXT_PUBLIC_GOOGLE_MAP="your_google_maps_api_key"

# Cron Job Secrets
CRON_SECRET="your_cron_secret_here"
